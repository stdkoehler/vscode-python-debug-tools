    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "react-plotly.js": "^2.6.0",
    "react-range": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.20",
    "@types/plotly.js": "^3.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
